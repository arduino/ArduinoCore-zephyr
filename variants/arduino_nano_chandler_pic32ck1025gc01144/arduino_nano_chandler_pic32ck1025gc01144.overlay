#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&zephyr_udc0 {
	board_cdc_acm_uart: board_cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};
};

&pinctrl {
	empty_default: empty_default {
		group1 {
			pinmux = <>;
		};
	};

	adc0_arduino: adc0_arduino {
		group1 {
			pinmux = <PB12B_ADC_VINP11>,
				 <PA5B_ADC_VINP1>,
				 <PA6B_ADC_VINP2>,
				 <PA7B_ADC_VINP3>,
				 <PA11B_ADC_VINP7>,
				 <PA12B_ADC_VINP8>,
				 <PA9B_ADC_VINP5>,
				 <PA10B_ADC_VINP6>;
		};
	};

	tcc1_arduino: tcc1_arduino {
		group1 {
			pinmux = <PC19F_TCC1_WO4>,
				 <PC20F_TCC1_WO5>,
				 <PC15F_TCC1_WO0>,
				 <PC16F_TCC1_WO1>,
				 <PC17F_TCC1_WO2>;
		};
	};

	tcc4_arduino: tcc4_arduino {
		group1 {
			pinmux = <PA21F_TCC4_WO1>,
				 <PA20F_TCC4_WO0>;
		};
	};

	tcc3_arduino_wo0: tcc3_arduino_wo0 {
		group1 {
			pinmux = <PB11G_TCC3_WO6>;
		};
	};

	tcc2_arduino_wo2: tcc2_arduino_wo2 {
		group1 {
			pinmux = <PD11F_TCC2_WO2>;
		};
	};

	tcc5_arduino_wo1: tcc5_arduino_wo1 {
		group1 {
			pinmux = <PA23F_TCC5_WO1>;
		};
	};

	tcc6_arduino_wo1: tcc6_arduino_wo1 {
		group1 {
			pinmux = <PB24F_TCC6_WO1>;
		};
	};
};

&adc0 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&adc0_arduino>;
	pinctrl-names = "default", "sleep", "arduino";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@b {
		reg = <11>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};

&sercom6 {
	zephyr,deferred-init;
};

&sercom4 {
	zephyr,deferred-init;
};

&sercom3 {
	zephyr,deferred-init;
};

&sercom2 {
	zephyr,deferred-init;
};

&sercom5 {
	zephyr,deferred-init;
};

&can0 {
	zephyr,deferred-init;
};

&tcc1 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc1_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc2 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc2_arduino_wo2>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc3 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc3_arduino_wo0>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc4 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc4_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc5 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc5_arduino_wo1>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc6 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc6_arduino_wo1>;
	pinctrl-names = "default", "sleep", "arduino";
};

&flash1 {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bootloader: dfu_boot: partition@0 {
			label = "dfu_boot";
			reg = <0x0 DT_SIZE_K(256)>;
		};

		slot0_partition: loader: partition@40000 {
			label = "loader";
			reg = <0x40000 DT_SIZE_K(512)>;
		};

		slot1_partition: user_sketch: partition@c0000 {
			label = "user_sketch";
			reg = <0xc0000 DT_SIZE_K(256)>;
		};
	};
};

/ {
	log_uarts: log_uarts {
		compatible = "zephyr,log-uart";
		uarts = <&sercom1 &board_cdc_acm_uart>;
	};

	chosen {
		zephyr,log-uart = &log_uarts;
		zephyr,console = &sercom1;
	};

	zephyr,user {

		digital-pin-gpios = <&portd 9 0>,   /* D0  (UART1 RX) */
					    <&portd 8 0>,   /* D1  (UART1 TX) */
					    <&portc 19 0>,  /* D2  */
					    <&portc 20 0>,  /* D3  */
					    <&porta 21 0>,  /* D4  */
					    <&porta 20 0>,  /* D5  */
					    <&portb 11 0>,  /* D6  */
					    <&portd 11 0>,  /* D7  */
					    <&porta 23 0>,  /* D8  */
					    <&portb 24 0>,  /* D9  */
					    <&porta 26 0>,  /* D10 */
					    <&portc 0 0>,   /* D11 */
					    <&porta 24 0>,  /* D12 */
					    <&porta 25 0>,  /* D13 */
					    <&portb 12 0>,  /* D14 / A0 */
					    <&porta 5 0>,   /* D15 / A1 */
					    <&porta 6 0>,   /* D16 / A2 */
					    <&porta 7 0>,   /* D17 / A3 */
					    <&porta 11 0>,  /* D18 / A4 */
					    <&porta 12 0>,  /* D19 / A5 */
					    <&porta 9 0>,   /* D20 / A6 */
					    <&porta 10 0>,  /* D21 / A7 */
					    <&portb 14 0>,  /* D22 */
					    <&portb 15 0>,  /* D23 */
					    <&portb 16 0>,  /* D24 / LED_BUILTIN */
					    <&portc 15 0>,  /* D25 / LEDR */
					    <&portc 16 0>,  /* D26 / LEDG */
					    <&portc 17 0>,  /* D27 / LEDB */
					    <&portd 5 0>,   /* D28 */
					    <&portd 12 0>;  /* D29 */

		builtin-led-gpios = <&portb 16 0>,
					    <&portc 15 0>,
					    <&portc 16 0>,
					    <&portc 17 0>;

		cdc-acm-serial = <&board_cdc_acm_uart>; /* 'Serial' object is managed by SerialUSB */
		serials = <&sercom1>, <&sercom6>, <&sercom0>;

		cans = <&can0>;

		i2cs = <&sercom4>, <&sercom3>;
		spis = <&sercom2>, <&sercom5>;

		pwm-pin-gpios = <&portc 19 0>,
				<&portc 20 0>,
				<&portc 15 0>,
				<&portc 16 0>,
				<&portc 17 0>,
				<&porta 21 0>,
				<&porta 20 0>,
				<&portb 11 0>,
				<&portd 11 0>,
				<&porta 23 0>,
				<&portb 24 0>;

		adc-pin-gpios = <&portb 12 0>,
				<&porta 5 0>,
				<&porta 6 0>,
				<&porta 7 0>,
				<&porta 11 0>,
				<&porta 12 0>,
				<&porta 9 0>,
				<&porta 10 0>;

		pwms = <&tcc1 4 PWM_HZ(500) 0>,
		       <&tcc1 5 PWM_HZ(500) 0>,
		       <&tcc1 0 PWM_HZ(500) PWM_POLARITY_INVERTED>,
		       <&tcc1 1 PWM_HZ(500) PWM_POLARITY_INVERTED>,
		       <&tcc1 2 PWM_HZ(500) PWM_POLARITY_INVERTED>,
		       <&tcc4 1 PWM_HZ(500) 0>,
		       <&tcc4 0 PWM_HZ(500) 0>,
		       <&tcc3 0 PWM_HZ(500) 0>,	
		       <&tcc2 2 PWM_HZ(500) 0>,
		       <&tcc5 1 PWM_HZ(500) 0>,
		       <&tcc6 1 PWM_HZ(500) 0>;

		io-channels = <&adc0 11>,
			      <&adc0 1>,
			      <&adc0 2>,
			      <&adc0 3>,
			      <&adc0 7>,
			      <&adc0 8>,
			      <&adc0 5>,
			      <&adc0 6>;
	};
};
