#include <zephyr/dt-bindings/pwm/stm32_pwm.h>


&fdcan1 {
	zephyr,deferred-init;
};

&fdcan2 {
	zephyr,deferred-init;
};

&uart7 {
	zephyr,deferred-init;
};

&i2c1 {
	zephyr,deferred-init;
};

&i2c2 {
	zephyr,deferred-init;
};

&adc2 {
	zephyr,deferred-init;
	pinctrl-0 = <>;
	pinctrl-1 = <>;
	pinctrl-2 = <&adc2_inp2_pf13 &adc2_inp6_pf14>;
	pinctrl-names = "default", "sleep", "arduino";
};

/ {
	zephyr,user {
		digital-pin-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>,   /* D0 user button */
				    /* LEDS */
				    <&gpiof 4 GPIO_ACTIVE_LOW>,    /* D1 LED1 blue */
				    <&gpioi 14 GPIO_ACTIVE_LOW>,   /* D2 LED1 green */
				    <&gpioi 12 GPIO_ACTIVE_LOW>,   /* D3 LED1 red */
				    <&gpiof 2 GPIO_ACTIVE_LOW>,    /* D4 LED2 blue */
				    <&gpioc 13 GPIO_ACTIVE_LOW>,   /* D5 LED2 green */
				    <&gpiok 13 GPIO_ACTIVE_LOW>,   /* D6 LED2 red */
				    <&gpioi 5 GPIO_ACTIVE_LOW>,    /* D7 LED3 blue */
				    <&gpioe 2 GPIO_ACTIVE_LOW>,    /* D8 LED3 green */
				    <&gpioi 7 GPIO_ACTIVE_LOW>,    /* D9 LED3 red */
				    <&gpiog 15 GPIO_ACTIVE_HIGH>,  /* D10 LED RADIO */
				    <&gpiob 7 GPIO_ACTIVE_HIGH>,   /* D11 LED ETH */
				    /* RELAY */
				    <&gpioh 2 GPIO_ACTIVE_HIGH>,   /* D12 RELAY 1 */
				    <&gpioh 3 GPIO_ACTIVE_HIGH>,   /* D13 RELAY 2*/
				    /* DETECT OUT */
				    <&gpiob 0 GPIO_ACTIVE_HIGH>,   /* D14 DETECT OUT */
				    /* RS485 RE */
					 <&gpiof 8 GPIO_ACTIVE_HIGH>,   /* D15 RE rs485 */
				    /* RS485 DE */
					 <&gpiof 9 GPIO_ACTIVE_HIGH>,   /* D16 DE rs485 */
				    /* ADCs */
				    <&gpiof 13 GPIO_ACTIVE_HIGH>,  /* A0 */
				    <&gpiof 14 GPIO_ACTIVE_HIGH>;  /* A1 */

		builtin-led-gpios = <&gpiof 4 GPIO_ACTIVE_LOW>,    /* D1 LED1 blue */
				    <&gpioi 14 GPIO_ACTIVE_LOW>,   /* D2 LED1 green */
				    <&gpioi 12 GPIO_ACTIVE_LOW>,   /* D3 LED1 red */
				    <&gpiof 2 GPIO_ACTIVE_LOW>,    /* D4 LED2 blue */
				    <&gpioc 13 GPIO_ACTIVE_LOW>,   /* D5 LED2 green */
				    <&gpiok 13 GPIO_ACTIVE_LOW>,   /* D6 LED2 red */
				    <&gpioi 5 GPIO_ACTIVE_LOW>,    /* D7 LED3 blue */
				    <&gpioe 2 GPIO_ACTIVE_LOW>,    /* D8 LED3 green */
				    <&gpioi 7 GPIO_ACTIVE_LOW>,    /* D9 LED3 red */
				    <&gpiog 15 GPIO_ACTIVE_HIGH>,  /* D10 LED RADIO */
				    <&gpiob 7 GPIO_ACTIVE_HIGH>;   /* D11 LED ETH */

		adc-pin-gpios =	<&gpiof 13 0>,
								<&gpiof 14 0>;

		io-channels = <&adc2 2>,   /* Corresponds to the first analog pin */
				        <&adc2 6>;   /* Corresponds to the second analog pin*/
		
		pwm-pin-gpios = <&gpiof 4 0>;
		
		cdc-acm-serial = <&board_cdc_acm_uart>;
		serials = <&uart7>, <&usart2>;

		/* uart9 and chip-en-gpios (gpioi 6) are wired internally to the
		 * ST67W611M1A6BTR Wi-Fi/BLE radio module (used to flash its
		 * firmware or talk to it directly over UART). Exposed here as
		 * 'coprocessor-*' rather than as a numbered Serial object, so
		 * the module's UART/control pins stay reserved for a bridge
		 * sketch (e.g. WiFiProgrammer) instead of colliding with the
		 * WiFi driver, which already owns chip-en-gpios on &st67w611m1. */
		coprocessor-serial = <&uart9>;
		coprocessor-boot-gpios = <&gpioi 11 GPIO_ACTIVE_HIGH>;
		coprocessor-reset-gpios = <&gpioi 6 GPIO_ACTIVE_HIGH>;

		i2cs = <&i2c2>, <&i2c1>, <&i2c4>;
		spis = <&spi4>, <&spi1>;

		pwms = <&pwm15 1 PWM_HZ(50) PWM_POLARITY_NORMAL>;

		cans = <&fdcan2>, <&fdcan1>;
	};

};

&phy0 {
	compatible = "microchip,ksz8081", "arduino,eth-phy";
};

/* Auto-mount the microSD card (sdhc0/mmc, disk-name = "SD") as a FAT
 * filesystem at "/SD:" on boot, when present. */
/ {
	fstab {
		compatible = "zephyr,fstab";

		sd_fs: sd_fs {
			compatible = "zephyr,fstab,fatfs";
			automount;
			disk-access;
			mount-point = "/SD:";
		};
	};
};

