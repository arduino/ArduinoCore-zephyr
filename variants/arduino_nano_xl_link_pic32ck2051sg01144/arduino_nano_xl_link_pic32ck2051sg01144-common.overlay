/*
 * Shared between the "nanoxllink" and "nanoxllink_monica" boards, which
 * both build out of this variant directory. Anything that differs between
 * the bare Nano XL Link module and the Monica carrier
 * (console/log routing, TCC2/D7 PWM, "serials" list, "pwms"/"pwm-pin-gpios")
 * is intentionally left out of this file - each variant's own .overlay
 * defines those itself.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&zephyr_udc0 {
	board_cdc_acm_uart: board_cdc_acm_uart {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};
};

&pinctrl {
	sercom2_spi_arduino: sercom2_spi_arduino {
		group1 {
			pinmux = <PC21C_SERCOM2_PAD0>, /* MOSI */
				 <PC23C_SERCOM2_PAD3>, /* MISO */
				 <PC22C_SERCOM2_PAD1>; /* SCK */
		};
	};

	sercom5_spi_arduino: sercom5_spi_arduino {
		group1 {
			pinmux = <PA27C_SERCOM5_PAD3>, /* MOSI */
				 <PA24C_SERCOM5_PAD0>, /* MISO */
				 <PA25C_SERCOM5_PAD1>; /* SCK */
		};
	};

	empty_default: empty_default {
		group1 {
			pinmux = <>;
		};
	};

	adc0_arduino: adc0_arduino {
		group1 {
			pinmux = <PB12B_ADC_VINP11>,
				 <PA5B_ADC_VINP1>,
				 <PA6B_ADC_VINP2>,
				 <PA7B_ADC_VINP3>,
				 <PA11B_ADC_VINP7>,
				 <PA12B_ADC_VINP8>,
				 <PA9B_ADC_VINP5>,
				 <PA10B_ADC_VINP6>;
		};
	};

	tcc1_arduino: tcc1_arduino {
		group1 {
			pinmux = <PC19F_TCC1_WO4>,
				 <PC20F_TCC1_WO5>,
				 <PC15F_TCC1_WO0>,
				 <PC16F_TCC1_WO1>,
				 <PC17F_TCC1_WO2>;
		};
	};

	tcc4_arduino: tcc4_arduino {
		group1 {
			pinmux = <PA21F_TCC4_WO1>,
				 <PA20F_TCC4_WO0>;
		};
	};

	tcc3_arduino_wo0: tcc3_arduino_wo0 {
		group1 {
			pinmux = <PB11G_TCC3_WO6>;
		};
	};

	tcc5_arduino_wo1: tcc5_arduino_wo1 {
		group1 {
			pinmux = <PA23F_TCC5_WO1>;
		};
	};

	tcc6_arduino_wo1: tcc6_arduino_wo1 {
		group1 {
			pinmux = <PB24F_TCC6_WO1>;
		};
	};
};

&adc0 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&adc0_arduino>;
	pinctrl-names = "default", "sleep", "arduino";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@b {
		reg = <11>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_VDD_1";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};

&sercom4 {
	zephyr,deferred-init;
};

&sercom3 {
	zephyr,deferred-init;
};

&sercom2 {
	zephyr,deferred-init;
	pinctrl-0 = <&sercom2_spi_arduino>;
};

&sercom5 {
	zephyr,deferred-init;
	pinctrl-0 = <&sercom5_spi_arduino>;
};

&can0 {
	zephyr,deferred-init;
};

&tcc1 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc1_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc3 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc3_arduino_wo0>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc4 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc4_arduino>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc5 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc5_arduino_wo1>;
	pinctrl-names = "default", "sleep", "arduino";
};

&tcc6 {
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&empty_default>;
	pinctrl-2 = <&tcc6_arduino_wo1>;
	pinctrl-names = "default", "sleep", "arduino";
};

/*
 * Flash layout, defined once in the board devicetree so the loader and
 * MCUboot cannot disagree. BFM and PFM are separate flash devices:
 *
 *   flash0 0x08000000  64K  boot_partition  MCUboot, active BFM Dual-Boot slot
 *   flash1 0x0C000000   1M  slot0 (image-0) loader + sketch, one image
 *   flash1 0x0C100000   1M  slot1 (image-1) DFU staging, copied over slot0
 *
 * Each slot is one 1 MB PFM panel. MCUboot is reached directly by the
 * hardware reset vector; the spare 64K BFM slot is not declared.
 *
 * zephyr-sketch-tool --squash appends the sketch to the erase-block padded
 * loader and hashes both as a single MCUboot image; the loader finds the
 * sketch at the offset stored after the MCUboot header
 * (CONFIG_LOADER_SKETCH_IN_MCUBOOT_IMAGE). Uploads go to slot1 over USB DFU
 * and MCUboot overwrites slot0 with them after checking the hash.
 *
 * upload.maximum_size follows automatically: extra/build.sh derives it from
 * this table and the signed loader size into boards.local.txt.
 */

/* Started by MCUboot, fed by the loader (CONFIG_APP_WATCHDOG_ENFORCED). */
&wdt {
	status = "okay";
};

/ {
	zephyr,user {
		digital-pin-gpios = <&porta 0 0>, /* D0 UART6 TX */
				    <&porta 1 0>,  /* D1 UART6 RX */
				    <&portc 19 0>, /* D2 */
				    <&portc 20 0>, /* D3 */
				    <&porta 21 0>, /* D4 */
				    <&porta 20 0>, /* D5 */
				    <&portb 11 0>, /* D6 */
				    <&portd 11 0>, /* D7 */
				    <&porta 23 0>, /* D8 */
				    <&portb 24 0>, /* D9 */
				    <&porta 26 0>, /* D10 SPI5 CS */
				    <&porta 27 0>, /* D11 SPI5 MOSI */
				    <&porta 24 0>, /* D12 SPI5 MISO */
				    <&porta 25 0>, /* D13 SPI5 SCK */
				    <&portb 12 0>, /* D14 A0 */
				    <&porta 5 0>,  /* D15 A1 */
				    <&porta 6 0>,  /* D16 A2 */
				    <&porta 7 0>,  /* D17 A3 */
				    <&porta 11 0>, /* D18 A4 */
				    <&porta 12 0>, /* D19 A5 */
				    <&porta 9 0>,  /* D20 A6 */
				    <&porta 10 0>, /* D21 A7 */
				    <&portc 21 0>, /* D22 SPI2 MOSI */
				    <&portc 23 0>, /* D23 SPI2 MISO */
				    <&portc 22 0>, /* D24 SPI2 SCK */
				    <&portc 14 0>, /* D25 SPI2 CS */
				    <&portb 21 0>, /* D26 I2C3 SDA */
				    <&portb 22 0>, /* D27 I2C3 SCL */
				    <&portd 14 0>, /* D28 I2S CK */
				    <&portd 13 0>, /* D29 I2S WS */
				    <&portd 16 0>, /* D30 I2S SDI */
				    <&portd 17 0>, /* D31 I2S SDO */
				    <&portd 8 0>, /* D32 UART1 TX */
				    <&portd 9 0>, /* D33 UART1 RX */
				    <&portb 4 0>, /* D34 I2C4 SDA */
				    <&portb 5 0>, /* D35 I2C4 SCL */
				    <&portb 14 0>, /* D36 Ethernet interrupt */
				    <&portb 15 0>, /* D37 Ethernet reset */
				    <&portb 16 0>, /* D38 LED_BUILTIN */
				    <&portc 15 0>, /* D39 LEDR */
				    <&portc 16 0>, /* D40 LEDG */
				    <&portc 17 0>, /* D41 LEDB */
				    <&portd 5 0>, /* D42 RS485 DE */
				    <&portd 12 0>; /* D43 RS485 /RE */

		builtin-led-gpios = <&portb 16 0>,
					    <&portc 15 0>,
					    <&portc 16 0>,
					    <&portc 17 0>;

		cdc-acm-serial = <&board_cdc_acm_uart>; /* 'Serial' object is managed by SerialUSB */

		cans = <&can0>;

		i2cs = <&sercom4>, <&sercom3>;
		spis = <&sercom5>, <&sercom2>;

		adc-pin-gpios = <&portb 12 0>,
				<&porta 5 0>,
				<&porta 6 0>,
				<&porta 7 0>,
				<&porta 11 0>,
				<&porta 12 0>,
				<&porta 9 0>,
				<&porta 10 0>;

		io-channels = <&adc0 11>,
			      <&adc0 1>,
			      <&adc0 2>,
			      <&adc0 3>,
			      <&adc0 7>,
			      <&adc0 8>,
			      <&adc0 5>,
			      <&adc0 6>;
	};
};
