#include <zephyr/dt-bindings/pwm/stm32_pwm.h>

/* USB CDC-ACM UART for console */
&zephyr_udc0 {
    board_cdc_acm_uart: board_cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
        status = "okay";
    };
};

&lpuart1 {
	status = "okay";
    /* lpuart1 is not set as deferred-init to catch early boot logs since it is assigned to zephyr,console */
};

/* I2C buses */
&i2c1 {
    status = "okay";
    zephyr,deferred-init;
};

&i2c2 {
    status = "okay";
    zephyr,deferred-init;
};

&i2c3 {
    status = "okay";
    zephyr,deferred-init;
};

&gc2145 {
    zephyr,deferred-init;
};

&pwmclock {
    status = "okay";
    zephyr,deferred-init;
};

&dcmi {
    zephyr,deferred-init;

    dmas = <&dma1 1 75 (STM32_DMA_PERIPH_TO_MEMORY | STM32_DMA_PERIPH_NO_INC |
            STM32_DMA_MEM_INC | STM32_DMA_PERIPH_32BITS | STM32_DMA_MEM_32BITS |
            STM32_DMA_PRIORITY_HIGH) STM32_DMA_FIFO_FULL>;
};

/* SPI buses */
&spi4 {
    status = "okay";
    zephyr,deferred-init;
    pinctrl-0 = <&spi4_sck_pe12 &spi4_miso_pe13 &spi4_mosi_pe14>;
    pinctrl-names = "default";
};

&spi5 {
    status = "okay";
    zephyr,deferred-init;
};

&rtc {
    status = "okay";

    clocks = <&rcc STM32_CLOCK(APB4, 16U)>,
             <&rcc STM32_SRC_LSE RTC_SEL(1)>;
};

/* PWM Timers */
&timers1 {
    status = "okay";
    st,prescaler = <0>;

    pwm1: pwm {
        status = "okay";
        zephyr,deferred-init;
        pinctrl-0 = <>;
        pinctrl-1 = <>;
        pinctrl-2 = <&tim1_ch2_pe11 &tim1_ch4_pe14 &tim1_ch3n_pe12 &tim1_ch3_pe13>;
        pinctrl-names = "default", "sleep", "arduino";
    };
};

&timers3 {
	status = "okay";
	st,prescaler = <0>;

	cam_clock_pwm: pwm {
		status = "okay";
		zephyr,deferred-init;
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <&tim3_ch2_pa7>;
		pinctrl-names = "default", "sleep", "arduino";
	};
};

&timers4 {
    status = "okay";
    st,prescaler = <100>;

    pwm4: pwm {
        status = "okay";
        zephyr,deferred-init;
        pinctrl-0 = <>;
        pinctrl-1 = <>;
        pinctrl-2 = <&tim4_ch4_pb9 &tim4_ch3_pb8>;
        pinctrl-names = "default", "sleep", "arduino";
    };
};

&adc12_common {
	st,adc-prescaler = <4>;
	st,adc-clock-source = "SYNC";
	status = "okay";
};

&adc1 {
    zephyr,deferred-init;
    pinctrl-0 = <>;
    pinctrl-1 = <>;
    pinctrl-2 = <&adc1_inp4_pc4>;
    pinctrl-names = "default", "sleep", "arduino";
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
        zephyr,resolution = <16>;
    };

    channel@12 {
        reg = <12>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
        zephyr,resolution = <16>;
    };
};

&adc2 {
    zephyr,deferred-init;
    pinctrl-0 = <>;
    pinctrl-1 = <>;
    pinctrl-2 = <&adc2_inp2_pf13>;
    pinctrl-names = "default", "sleep", "arduino";
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
        zephyr,resolution = <16>;
    };
};

&adc3_common {
	st,adc-prescaler = <4>;
	st,adc-clock-source = "SYNC";
	status = "okay";
};

&adc3 {
    zephyr,deferred-init;
    pinctrl-0 = <>;
    pinctrl-1 = <>;
    pinctrl-2 = <&adc3_inp5_pf3>;
    pinctrl-names = "default", "sleep", "arduino";
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
        zephyr,resolution = <16>;
    };
};

/ {

    chosen {
        zephyr,console = &lpuart1;
        zephyr,shell-uart = &lpuart1;
        zephyr,log-uart = &log_uarts;
        arduino,camera-clock = &pwmclock;
    };

	log_uarts: log_uarts {
		compatible = "zephyr,log-uart";
		uarts = <&lpuart1 &board_cdc_acm_uart>;
	};

    /* used to overcome problems with _C analog pins */
    gpio_invalid: gpio@deadbeef {
        compatible = "vnd,gpio";
        gpio-controller;
        reg = <0xdeadbeef 0x1000>;
        #gpio-cells = <0x2>;
        status = "okay";
    };
};

/*
 * Custom partition layout for Arduino Core compatibility:
 * - mcuboot: 256KB bootloader
 * - image-0: 640KB loader slot
 * - user_sketch: rest of Flash
 */

&flash0 {
	reg = <0x8000000 DT_SIZE_K(2048)>;     /* assign all Flash to the M7 */
	status = "okay";

	partitions {
		slot0_partition: partition@40000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00040000 0x000A0000>;
		};

		user_sketch: partition@e0000 {
			compatible = "zephyr,mapped-partition";
			label = "user_sketch";
			reg = <0x000E0000 0x00120000>;
		};
	};
};

/ {
    zephyr,user {
        digital-pin-gpios = <&gpiog 12 GPIO_ACTIVE_HIGH>, /* D0 D0 */
                            <&gpioa 9 GPIO_ACTIVE_HIGH>, /* D1 D1 TX */
                            <&gpioa 10 GPIO_ACTIVE_HIGH>, /* D2 D2 RX */
                            <&gpiog 1 GPIO_ACTIVE_HIGH>, /* D3 D3 */
                            <&gpioc 7 GPIO_ACTIVE_HIGH>, /* D4 D4 */
                            <&gpioc 6 GPIO_ACTIVE_HIGH>, /* D5 D5 */
                            <&gpiof 6 GPIO_ACTIVE_HIGH>, /* D6 SPI1 SS */
                            <&gpioe 11 GPIO_ACTIVE_HIGH>, /* D7 SPI SS */
                            <&gpioe 14 GPIO_ACTIVE_HIGH>, /* D8 SPI MOSI */
                            <&gpioe 12 GPIO_ACTIVE_HIGH>, /* D9 SPI SCK */
                            <&gpioe 13 GPIO_ACTIVE_HIGH>, /* D10 SPI MISO */
                            <&gpiob 9 GPIO_ACTIVE_HIGH>, /* D11 Wire SDA */
                            <&gpiob 8 GPIO_ACTIVE_HIGH>, /* D12 Wire SCL */
                            <&gpioc 9 GPIO_ACTIVE_HIGH>, /* D13 Wire2 SDA */
                            <&gpioa 8 GPIO_ACTIVE_HIGH>, /* D14 Wire2 SCL */
                            <&gpioc 4 GPIO_ACTIVE_HIGH>, /* D15 A0 */
                            <&gpiof 13 GPIO_ACTIVE_HIGH>, /* D16 A1 */
                            <&gpiof 3 GPIO_ACTIVE_HIGH>, /* D17 A2 */
                            <&gpio_invalid 0 GPIO_ACTIVE_HIGH>, /* D18 Reserved (I2C3 SDA) */
                            <&gpio_invalid 1 GPIO_ACTIVE_HIGH>, /* D19 Reserved (I2C3 SCL) */
                            <&gpiof 11 GPIO_ACTIVE_HIGH>, /* D20 SPI1 MOSI */
                            <&gpiof 7 GPIO_ACTIVE_HIGH>, /* D21 SPI1 SCK */
                            <&gpiof 8 GPIO_ACTIVE_HIGH>, /* D22 SPI1 MISO */
                            <&gpioe 3 GPIO_ACTIVE_HIGH>, /* D23 LEDR */
                            <&gpioc 13 GPIO_ACTIVE_HIGH>, /* D24 LEDG */
                            <&gpiof 4 GPIO_ACTIVE_HIGH>, /* D25 LEDB */
                            <&gpioa 0 GPIO_ACTIVE_HIGH>, /* D26 PA0 */
                            <&gpioa 1 GPIO_ACTIVE_HIGH>, /* D27 IMU interrupt */
                            <&gpiog 0 GPIO_ACTIVE_HIGH>, /* D28 SE05X_EN */
                            <&gpio_invalid 2 GPIO_ACTIVE_HIGH>, /* D29 Reserved */
                            <&gpio_invalid 3 GPIO_ACTIVE_HIGH>, /* D30 Reserved */
                            <&gpio_invalid 4 GPIO_ACTIVE_HIGH>, /* D31 Reserved */
                            <&gpio_invalid 5 GPIO_ACTIVE_HIGH>, /* D32 Reserved */
                            <&gpio_invalid 6 GPIO_ACTIVE_HIGH>, /* D33 Reserved */
			    <&gpiog 10 GPIO_ACTIVE_HIGH>; /* D34 VL53L1CB XSHUT */

        adc-pin-gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>,   /* A0 PC4  */
                        <&gpiof 13 GPIO_ACTIVE_HIGH>,   /* A1 PF13 */
                        <&gpiof 3 GPIO_ACTIVE_HIGH>;    /* A2 PF3  */

        pwm-pin-gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>,  /* D7  PE11 pwm1 ch2  */
                        <&gpioe 14 GPIO_ACTIVE_HIGH>,   /* D8  PE14 pwm1 ch4  */
                        <&gpioe 12 GPIO_ACTIVE_HIGH>,   /* D9  PE12 pwm1 ch3n */
                        <&gpioe 13 GPIO_ACTIVE_HIGH>,   /* D10 PE13 pwm1 ch3  */
                        <&gpiob 9 GPIO_ACTIVE_HIGH>,    /* D11 PB9  pwm4 ch4  */
                        <&gpiob 8 GPIO_ACTIVE_HIGH>;    /* D12 PB8  pwm4 ch3  */

        serials = <&board_cdc_acm_uart>, <&usart1>, <&lpuart1>;
        cdc-acm-serial = <&board_cdc_acm_uart>;

        i2cs = <&i2c1>, <&i2c2>, <&i2c3>;
        spis = <&spi4>, <&spi5>;

        io-channels = <&adc1 4>,
                  <&adc2 2>,
                  <&adc3 5>;

        builtin-led-gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>, /* Green LED PC_13 (LED_BUILTIN) */
                            <&gpioe 3 GPIO_ACTIVE_HIGH>,  /* Red LED PE_3 */
                            <&gpiof 4 GPIO_ACTIVE_HIGH>;  /* Blue LED PF_4 */

        /*
         * PWM channels: timers1(ch2,ch4,ch3n,ch3), timers4(ch4,ch3).
         * D9 (CH3N) and D10 (CH3) share the same channel, and duty cycle.
         */
        pwms =  <&pwm1 2 PWM_HZ(1000) PWM_POLARITY_NORMAL>,
                <&pwm1 4 PWM_HZ(1000) PWM_POLARITY_NORMAL>,
                <&pwm1 3 PWM_HZ(1000) (PWM_POLARITY_NORMAL | STM32_PWM_COMPLEMENTARY)>,
                <&pwm1 3 PWM_HZ(1000) PWM_POLARITY_NORMAL>,
                <&pwm4 4 PWM_HZ(1000) PWM_POLARITY_NORMAL>,
                <&pwm4 3 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
    };
};

&sram1 {
	reg = <0x30000000 DT_SIZE_K(256)>;
};

/delete-node/ &sram2;

&pll2 {
	status = "okay";
};

dfsdm: &dfsdm {
	zephyr,deferred-init;
	status = "okay";
};

dmic_dev: &pdm0 {
	zephyr,deferred-init;
	filter-order = <5>;
	status = "okay";
};

/* Include common flash filesystem configuration */
qspi_flash: &n25q128a1 {};
#include "../common/arduino_flash_fs.dtsi"
