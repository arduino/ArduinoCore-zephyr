config ARDUINO_IOTCLOUD
	bool "Arduino IoT Cloud support"
	default y if BOARD_ARDUINO_NICLA_VISION
	default y if BOARD_ARDUINO_PORTENTA_H7
	default y if BOARD_ARDUINO_OPTA
	default y if BOARD_ARDUINO_GIGA
	default y if BOARD_ARDUINO_PORTENTA_C33
	default y if BOARD_ARDUINO_NANO_CONNECT
	depends on NETWORKING
	depends on NET_TCP
	depends on NET_SOCKETS
	help
	  Enable the Arduino IoT Cloud support and bring in zephyr packages required to run it

if ARDUINO_IOTCLOUD

config ARDUINO_IOTCLOUD_OTA
	bool "Arduino IoT Cloud OTA support"
	default y if BOARD_ARDUINO_NICLA_VISION
	default y if BOARD_ARDUINO_PORTENTA_H7
	default y if BOARD_ARDUINO_OPTA
	default y if BOARD_ARDUINO_GIGA
	select OTA

endif # ARDUINO_IOTCLOUD
