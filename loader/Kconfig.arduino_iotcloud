config ARDUINO_IOTCLOUD
	bool "Arduino IoT Cloud support"
	depends on NETWORKING
	depends on NET_TCP
	depends on NET_SOCKETS
	imply SETTINGS				if !BOARD_ARDUINO_NANO_CONNECT
	imply NVS				if !BOARD_ARDUINO_NANO_CONNECT
	imply NVS_DATA_CRC			if !BOARD_ARDUINO_NANO_CONNECT
	imply NVS_INIT_BAD_MEMORY_REGION	if !BOARD_ARDUINO_NANO_CONNECT
	select CRC_DRIVER
	select CRC_DRIVER_HAS_CRC32_IEEE
	help
	  Enable the Arduino IoT Cloud support and bring in zephyr packages required to run it

config ARDUINO_IOTCLOUD_OTA
	bool "Arduino IoT Cloud OTA support"
	depends on ARDUINO_IOTCLOUD && OTA
	default y
