config PINCTRL
	select PINCTRL_NON_STATIC

config USB_CONFIGURATION_STRING_DESC
	default "$(APP_VERSION_EXTENDED_STRING)"

source "Kconfig.zephyr"

config LLEXT_HEAP_REGION
	string "LLEXT heap memory region"
	depends on CODE_DATA_RELOCATION
	help
	  Specify the memory region for LLEXT heap.

config MAIN_STACK_REGION
	string "Main stack memory region"
	depends on CODE_DATA_RELOCATION
	help
	  Specify the memory region for main stack.

config LOADER_DFU_MAGIC
  int "Number used to activate the loader DFU via memory retention"
  range 0 255
  default 120

config USE_DFU_FLASH_UPDATES
    bool "Enable USB DFU flash updates (loader and sketch images)"
    default y if BOARD_ARDUINO_MEZZA
    help
      Enables the USB DFU class used to flash updates to the loader image
      and the user sketch image.

config USE_DFU_FADING_BLINK
    bool "Enable fading LED blink while waiting for a DFU update"
    default y if BOARD_ARDUINO_MEZZA
    depends on USE_DFU_FLASH_UPDATES
    help
      Blinks a PWM-driven LED with a fade effect while the board is waiting
      for a DFU update to be applied. Requires a "fade_led" alias in the
      device tree.

config WAIT_FOR_DFU_IF_SKETCH_IS_NOT_VALID
    bool "Wait for a DFU update when the sketch header is invalid"
    default y if BOARD_ARDUINO_MEZZA
    depends on USE_DFU_FLASH_UPDATES
    help
      If the sketch stored in flash has an invalid header, block and wait
      for a DFU update instead of attempting to start it.

rsource "ota/Kconfig"
