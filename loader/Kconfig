config PINCTRL
	select PINCTRL_NON_STATIC

config USB_CONFIGURATION_STRING_DESC
	default "$(APP_VERSION_EXTENDED_STRING)"


config LLEXT_HEAP_REGION
	string "LLEXT heap memory region"
	depends on CODE_DATA_RELOCATION
	help
	  Specify the memory region for LLEXT heap.

config MAIN_STACK_REGION
	string "Main stack memory region"
	depends on CODE_DATA_RELOCATION
	help
	  Specify the memory region for main stack.

menu "Flash Padding Options"

choice FLASH_PADDING_STRATEGY
    prompt "Flash padding strategy"
    optional
    depends on !LINKER_LAST_SECTION_ID
	 depends on !MCUBOOT
    help
      Select how the firmware image is padded. Requires CONFIG_LINKER_LAST_SECTION_ID=n.

config FLASH_ALIGN_BASED_ON_DT_ERASE_DIM
    bool "Align based on Devicetree erase block size"

config CUSTOM_FLASH_ALIGN_ACTIVE
    bool "Align to a custom dimension"

endchoice

config CUSTOM_FLASH_ALIGN
    int "Custom flash alignment boundary"
    depends on CUSTOM_FLASH_ALIGN_ACTIVE
    default 1024
    help
      The dimension to align the padding to, disregarding the Devicetree block size.

endmenu

config LOADER_DFU_MAGIC
  int "Number used to activate the loader DFU via memory retention"
  range 0 255
  default 120

config APP_WATCHDOG_ENFORCED
    bool "Hardware watchdog enforced by Sysbuild (MCU Boot required)"
    default n
    help
      This is automatically set to 'y' by Sysbuild if the secure 
      watchdog parameters are injected into MCUBoot.

config APP_WATCHDOG_TIMEOUT_MS
    int "Watchdog timeout injected by Sysbuild"
    default 20000

config USE_NETWORK_LED_TRACKER
    bool "Enable LED blinking depending on network activity"
    default y if BOARD_ARDUINO_MEZZA
    help
      To get this working it is necessary to have led_ethernet and led_wifi
      defined as aliases in the device tree

config USE_DFU_FLASH_UPDATES
    bool "Enable USB DFU flash updates (loader and sketch images)"
    default y if BOARD_ARDUINO_MEZZA
    help
      Enables the USB DFU class used to flash updates to the loader image
      and the user sketch image.

config USE_LOADER_AND_BINARY_SQUASHED
    bool "Loader and sketch share a single squashed flash image"
    default y if BOARD_ARDUINO_MEZZA
    depends on USE_DFU_FLASH_UPDATES
    help
      Enable this when the loader and the sketch are packed together into
      a single flash image whose layout (sketch offset, erase size, block
      count and padding) is only known at runtime. When enabled, the
      loader reads this layout from the image header via
      retrieve_flash_info() instead of relying on statically retained
      sketch_base_addr/sketch_max_size symbols. This layout is only
      produced to support the dynamic sketch DFU alternate, hence the
      dependency on USE_DFU_FLASH_UPDATES.

config USE_DFU_FADING_BLINK
    bool "Enable fading LED blink while waiting for a DFU update"
    default y if BOARD_ARDUINO_MEZZA
    depends on USE_DFU_FLASH_UPDATES
    help
      Blinks a PWM-driven LED with a fade effect while the board is waiting
      for a DFU update to be applied. Requires a "fade_led" alias in the
      device tree.

config WAIT_FOR_DFU_IF_SKETCH_IS_NOT_VALID
    bool "Wait for a DFU update when the sketch header is invalid"
    default y if BOARD_ARDUINO_MEZZA
    depends on USE_DFU_FLASH_UPDATES
    help
      If the sketch stored in flash has an invalid header, block and wait
      for a DFU update instead of attempting to start it.

source "Kconfig.zephyr"
rsource "ota/Kconfig"
